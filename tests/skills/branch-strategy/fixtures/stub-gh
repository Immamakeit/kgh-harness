#!/usr/bin/env bash
# tests/skills/branch-strategy/fixtures/stub-gh
#
# 실제 GitHub에 절대 접속하지 않는 가짜 `gh` — branch-strategy 스킬의
# RED/GREEN 관찰 전용. PATH 맨 앞에 이 파일이 있는 디렉토리를 두면 진짜 `gh`
# 대신 이 스크립트가 호출을 가로챈다.
#
# 환경변수:
#   STUB_GH_LOG      필수. 모든 호출 인자를 append로 기록한다(사후 검사용).
#   STUB_GH_SCENARIO 시나리오 이름. 기본 solo_unprotected. 아래 case 참조.
#   STUB_GH_OWNER    기본 testowner
#   STUB_GH_REPO     기본 testrepo
#
# 시나리오: solo_unprotected · no_auth · no_scope · no_admin · already_protected
#   (not_github 시나리오는 이 스텁이 아니라 호출 측이 git remote를 바꿔 재현한다 —
#   gh 호출 이전에 git 원격 확인에서 막혀야 정상이므로 이 스크립트에 분기가 없다.)
set -euo pipefail

: "${STUB_GH_LOG:?STUB_GH_LOG 미지정 — 로그 파일 경로를 지정하십시오}"
owner="${STUB_GH_OWNER:-testowner}"
repo="${STUB_GH_REPO:-testrepo}"
scenario="${STUB_GH_SCENARIO:-solo_unprotected}"

printf '%s\n' "$*" >> "$STUB_GH_LOG"

# ---- no_auth 시나리오: 인증 자체가 없다 — auth status는 물론 api 호출도
#      전부 401급으로 실패해야 실제 gh와 같은 조건이 된다(그래야 스킬이
#      auth 실패 직후 멈추는지, 이후 호출을 아예 시도하지 않는지가 드러난다). --
if [ "$scenario" = "no_auth" ]; then
  if [ "${1:-}" = "auth" ] && [ "${2:-}" = "status" ]; then
    echo "You are not logged into any GitHub hosts. Run gh auth login to authenticate." >&2
    exit 1
  fi
  echo "gh: To use GitHub CLI in a GitHub Actions workflow, set the GH_TOKEN environment variable. HTTP 401: Bad credentials" >&2
  exit 1
fi

# ---- gh auth status ---------------------------------------------------------
if [ "${1:-}" = "auth" ] && [ "${2:-}" = "status" ]; then
  echo "github.com"
  echo "  ✓ Logged in to github.com account testowner (keyring)"
  echo "  ✓ Git operations for github.com configured to use https protocol."
  echo "  ✓ Token scopes: 'gist', 'read:org', 'repo', 'workflow'"
  exit 0
fi

# ---- gh api ... -------------------------------------------------------------
if [ "${1:-}" = "api" ]; then
  shift
  show_headers=0
  method=""
  endpoint=""
  jq_filter=""
  prev=""
  for arg in "$@"; do
    case "$prev" in
      -X|--method)
        method="$arg"
        prev="$arg"
        continue
        ;;
      --jq)
        jq_filter="$arg"
        prev="$arg"
        continue
        ;;
    esac
    case "$arg" in
      -i) show_headers=1 ;;
      -X|--method) : ;;
      --jq) : ;;
      -*) : ;;
      *)
        if [ -z "$endpoint" ] && [ "$prev" != "--jq" ]; then
          endpoint="$arg"
        fi
        ;;
    esac
    prev="$arg"
  done

  case "$endpoint" in
    /user)
      if [ "$scenario" = "no_scope" ]; then
        [ "$show_headers" = 1 ] && printf 'HTTP/2.0 200 OK\r\nX-Oauth-Scopes: gist, read:org\r\n\r\n'
      else
        [ "$show_headers" = 1 ] && printf 'HTTP/2.0 200 OK\r\nX-Oauth-Scopes: gist, read:org, repo, workflow\r\n\r\n'
      fi
      # 실제 gh는 --jq 필터를 적용해 bare 값을 낸다(전체 JSON을 그대로 내지 않는다).
      # 이 스텁은 SKILL.md가 실제로 쓰는 필터만 흉내낸다 — 범용 jq 구현이 아니다.
      case "$jq_filter" in
        .login) echo "testowner" ;;
        *) echo '{"login":"testowner"}' ;;
      esac
      exit 0
      ;;
    "repos/${owner}/${repo}")
      if [ "$scenario" = "no_admin" ]; then
        admin_val=false
      else
        admin_val=true
      fi
      case "$jq_filter" in
        .permissions.admin) echo "$admin_val" ;;
        *) echo "{\"permissions\":{\"admin\":${admin_val}},\"default_branch\":\"main\",\"private\":false,\"delete_branch_on_merge\":false}" ;;
      esac
      exit 0
      ;;
    "repos/${owner}/${repo}/collaborators")
      echo '[{"login":"testowner","permissions":{"admin":true}}]'
      exit 0
      ;;
    "repos/${owner}/${repo}/branches/main/protection")
      if [ -n "$method" ] && [ "$method" != "GET" ]; then
        echo "STUB-GH: 쓰기 요청 가로챔(실제 GitHub 미전송) — method=${method} $*" >> "$STUB_GH_LOG"
        echo '{"url":"stub://write-intercepted"}'
        exit 0
      fi
      if [ "$scenario" = "already_protected" ]; then
        cat <<'JSON'
{"required_pull_request_reviews":{"required_approving_review_count":0},"enforce_admins":{"enabled":false},"allow_force_pushes":{"enabled":false},"allow_deletions":{"enabled":false},"required_status_checks":null}
JSON
        exit 0
      fi
      # 실제 gh는 JSON 본문을 stdout, 'gh: <메시지> (HTTP 404)' 진단 줄을 stderr로
      # 나눠 쓴다(실측: gh api repos/{o}/{r}/branches/main/protection, 보호 없는
      # 공개 저장소 대상). 스트림을 분리해 파싱하는 스킬 로직이 stdout에서 실제
      # 본문을 볼 수 있어야 한다.
      echo '{"message":"Branch not protected","documentation_url":"https://docs.github.com/rest/branches/branch-protection#get-branch-protection","status":"404"}'
      echo "gh: Branch not protected (HTTP 404)" >&2
      exit 1
      ;;
    *)
      echo "STUB-GH: 미정의 엔드포인트 — '${endpoint}' ($*)" >&2
      exit 1
      ;;
  esac
fi

echo "STUB-GH: 미정의 명령 — $*" >&2
exit 1
