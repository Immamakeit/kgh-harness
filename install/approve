#!/usr/bin/env bash
# install/approve — ⑤ 설계 승인 마커를 남긴다 (PreToolUse 게이트를 푼다).
#
# 게이트(adapters/claude/hooks/pre-tool-use.sh)는 "설계 문서가 있고 .approved 가 없는
# 작업"을 승인 대기로 보고 작업 문서 밖의 편집을 막는다. 이 명령이 그 마커를 만든다.
#
# 정직하게: 에이전트도 이 명령을 실행할 수 있다. 막을 방법은 없다(셸이 있으니까).
# 그래서 **조용히는 못 하게** 만들었다 — 마커에 승인 시각과 승인 경로(tty / 비대화형
# 플래그)가 적히고, git diff 에 그대로 드러난다. 비대화형에서는 --by-user 를 명시해야
# 하고 그 사실이 마커에 남는다.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./lib.sh
source "${SCRIPT_DIR}/lib.sh"

# 설치본(<프로젝트>/.harness/install/approve)이면 프로젝트 루트는 두 단계 위다.
# 소스 레포(install/approve)면 한 단계 위다 — 둘 다 harness.config.yaml 의 위치로 가린다.
TARGET_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
if [ ! -f "${TARGET_DIR}/harness.config.yaml" ] && [ -f "$(cd "${SCRIPT_DIR}/../.." && pwd)/harness.config.yaml" ]; then
  TARGET_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"
fi

usage() {
  cat <<'USAGE'
kgh-harness install/approve — ⑤ 설계 승인 마커를 남긴다.

사용법:
  approve <작업명>              승인 마커 생성 (대화형 확인)
  approve <작업명> --by-user    비대화형 승인 — 사용자 승인을 이미 받았음을 명시
  approve --list                작업별 승인 상태
  approve --revoke <작업명>     마커 철회 (게이트 재무장)
  approve -h | --help

게이트 모드는 harness.config.yaml 의 gate.enforce (block 기본 / warn / off).
USAGE
}

WORKROOT="$(workdocs_root "$TARGET_DIR")"
DESIGN="$(design_doc_name "$TARGET_DIR")"

# find_task_dir <작업명> → 가장 최근(사전순 최대) 설계 문서 디렉터리를 stdout
find_task_dir() {
  local task="$1"
  [ -d "${WORKROOT}/${task}" ] || return 1
  find "${WORKROOT}/${task}" -mindepth 1 -maxdepth 3 -type f -name "$DESIGN" 2>/dev/null \
    | sort | tail -n1 | xargs -r dirname
}

list_tasks() {
  say "=== 작업별 승인 상태 ==="
  say "작업 문서 루트: ${WORKROOT}"
  echo
  if [ ! -d "$WORKROOT" ]; then
    note "작업 문서 디렉터리가 아직 없습니다 — 흐름이 시작된 적이 없습니다."
    return 0
  fi
  local found=0 d task state
  while IFS= read -r design_file; do
    [ -n "$design_file" ] || continue
    found=1
    d="$(dirname "$design_file")"
    task="${d#"${WORKROOT}/"}"
    if [ -f "${d}/.approved" ]; then
      state="$(grep -E '^승인경로=' "${d}/.approved" 2>/dev/null | head -n1 | cut -d= -f2-)"
      ok "  [승인] ${task}  (경로: ${state:-미기록})"
    else
      warn "  [대기] ${task}  ← 게이트 무장 중"
    fi
  done < <(find "$WORKROOT" -mindepth 1 -maxdepth 4 -type f -name "$DESIGN" 2>/dev/null | sort)
  [ "$found" -eq 1 ] || note "설계 문서를 가진 작업이 없습니다."
}

# ---- 인자 파싱 --------------------------------------------------------------

TASK=""
BY_USER=0
ACTION="approve"
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --list)    ACTION="list" ;;
    --revoke)  ACTION="revoke"; TASK="${2:-}"; shift || true ;;
    --by-user) BY_USER=1 ;;
    -*)
      hrn_err "E004" "알 수 없는 옵션: $1" \
        "approve --help 로 사용법을 확인하세요" \
        "의도한 옵션이라면 install/approve 를 고치세요"
      exit 1 ;;
    *) TASK="$1" ;;
  esac
  shift
done

if [ "$ACTION" = "list" ]; then
  list_tasks
  exit 0
fi

if [ -z "$TASK" ]; then
  hrn_err "E004" "작업명이 없습니다" \
    "approve <작업명> 형태로 실행하세요 (approve --list 로 작업명을 확인할 수 있습니다)" \
    "approve --help 로 사용법을 확인하세요"
  exit 1
fi

TASK_DIR="$(find_task_dir "$TASK" || true)"
if [ -z "$TASK_DIR" ]; then
  hrn_err "E005" "작업 '${TASK}' 의 설계 문서(${DESIGN})를 찾지 못했습니다 (탐색: ${WORKROOT}/${TASK})" \
    "approve --list 로 실제 작업명을 확인한 뒤 다시 실행하세요" \
    "설계 문서를 아직 안 썼다면 ⑤ 설계부터 수행하세요 — 승인할 대상이 없습니다"
  exit 1
fi

# ---- 철회 -------------------------------------------------------------------

if [ "$ACTION" = "revoke" ]; then
  if [ ! -f "${TASK_DIR}/.approved" ]; then
    note "이미 승인 마커가 없습니다 (게이트는 이미 무장 상태): ${TASK_DIR}"
    exit 0
  fi
  say "철회 대상: ${TASK_DIR}/.approved"
  if [ "$(ask_yn "이 작업의 승인을 철회하고 게이트를 다시 무장할까요?" "N")" = "Y" ]; then
    rm -f "${TASK_DIR}/.approved"
    ok "승인을 철회했습니다 — '${TASK}' 는 다시 승인 대기입니다."
  else
    say "철회하지 않았습니다."
  fi
  exit 0
fi

# ---- 승인 -------------------------------------------------------------------

if [ -f "${TASK_DIR}/.approved" ]; then
  ok "이미 승인된 작업입니다: ${TASK_DIR}/.approved"
  sed -n '3,$p' "${TASK_DIR}/.approved" | sed 's/^/  /'
  exit 0
fi

say "=== ⑤ 설계 승인 ==="
say "작업    : ${TASK}"
say "설계 문서: ${TASK_DIR}/${DESIGN}"
SUMMARY="$(grep -A2 '^> \[!summary\]' "${TASK_DIR}/${DESIGN}" 2>/dev/null | tail -n1 | sed 's/^> *//')"
[ -n "$SUMMARY" ] && say "요약    : ${SUMMARY}"
echo

VIA=""
if [ -t 0 ]; then
  say "이 승인은 ⑦ 구현의 전제입니다. 설계를 읽고 사용자가 직접 승인해야 합니다."
  if [ "$(ask_yn "설계를 승인합니까?" "N")" != "Y" ]; then
    say "승인하지 않았습니다 — 게이트는 그대로 무장 상태입니다."
    exit 0
  fi
  VIA="tty"
else
  if [ "$BY_USER" -ne 1 ]; then
    hrn_err "E016" "비대화형에서 승인하려면 --by-user 를 명시해야 합니다 (작업: ${TASK})" \
      "사용자 승인을 이미 받았다면: approve ${TASK} --by-user" \
      "승인을 받지 않았다면 사용자에게 설계를 제시하십시오 — 이 게이트의 목적입니다"
    exit 1
  fi
  VIA="flag(비대화형 --by-user)"
  note "(비대화형) --by-user 로 승인 — 이 사실이 마커에 기록됩니다."
fi

write_approval_marker "$TASK_DIR" "$TASK" "$VIA" "$DESIGN" "$TARGET_DIR"
ok "승인 마커 생성: ${TASK_DIR}/.approved"
sed -n '3,$p' "${TASK_DIR}/.approved" | sed 's/^/  /'
echo
say "게이트가 풀렸습니다 — ⑦ 구현을 진행할 수 있습니다."
say "철회하려면: $(basename "$0") --revoke ${TASK}"
