#!/usr/bin/env bash
# install/setup [대상경로] — kgh-harness 최초 설치 + 1회 세팅.
# 소스 레포(이 파일이 들어있는 레포)에서 실행한다: ./install/setup /path/to/project
#
# interactive-script 스킬 표준 적용: 사전 점검 → 대화형+디폴트(비TTY 폴백) →
# silent 에러 금지(HRN 코드) → 종료 요약.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SOURCE_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
# shellcheck source=./lib.sh
source "${SCRIPT_DIR}/lib.sh"

usage() {
  cat <<'USAGE'
kgh-harness install/setup — 하네스를 대상 프로젝트에 설치하고 1회 세팅한다.

사용법:
  install/setup <대상 프로젝트 경로>
  install/setup -h | --help

동작:
  1) 사전 점검 (rsync·python3·하네스 CLI·superpowers)
  2) .harnessignore 를 적용해 배포물을 <대상>/.harness/ 로 복사
  3) <대상>/harness.config.yaml 생성 (이미 있으면 보존 — 덮어쓰지 않음)
  4) storage.vault_root 대화형 지정 (비대화형이면 건너뜀 — HRN-W010)
  5) <대상>/.claude/settings.json 에 SessionStart 훅 병합 (기존 훅 보존)
  6) 컨피그 검증 후 종료 요약

비대화형(에이전트·CI): 표준입력이 TTY가 아니면 모든 질문이 디폴트로 처리되고
그 사실이 로그에 남는다. 대상 경로는 반드시 인자로 넘겨야 한다 —
인자를 생략하면 대상이 소스 레포 자신이 되어 HRN-E007로 차단된다.

예시:
  git clone https://github.com/Immamakeit/kgh-harness.git ~/.kgh-harness
  ~/.kgh-harness/install/setup /path/to/project
  cd /path/to/project && .harness/install/validate-config
USAGE
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

say "=== kgh-harness 설치 ==="
say "소스 레포: ${SOURCE_DIR}"
echo

# ---- 1. 사전 점검 ----------------------------------------------------------

if [ ! -f "${SOURCE_DIR}/core/playbook.md" ]; then
  hrn_err "E005" "소스 레포 무결성 실패 — core/playbook.md 미발견 (${SOURCE_DIR})" \
    "하네스 소스 레포(kgh-harness) 루트에서 실행하세요 — git clone https://github.com/Immamakeit/kgh-harness.git" \
    "git status/git checkout으로 소스 레포를 정상 상태로 복원하세요"
  exit 1
fi

if [ ! -f "${SOURCE_DIR}/.harnessignore" ]; then
  hrn_err "E005" ".harnessignore 미발견 — 배포 제외 목록 없이는 설치할 수 없음 (${SOURCE_DIR})" \
    "하네스 소스 레포(kgh-harness) 루트에서 실행하세요 — git clone https://github.com/Immamakeit/kgh-harness.git" \
    "git status/git checkout으로 소스 레포를 정상 상태로 복원하세요"
  exit 1
fi

if [ ! -f "${SOURCE_DIR}/config/harness.config.template.yaml" ]; then
  hrn_err "E005" "템플릿 컨피그 미발견 — config/harness.config.template.yaml (${SOURCE_DIR})" \
    "하네스 소스 레포 루트에서 install/setup을 실행하세요 (git clone https://github.com/Immamakeit/kgh-harness.git)" \
    "git checkout으로 config/harness.config.template.yaml을 복원하세요"
  exit 1
fi

if ! command -v rsync >/dev/null 2>&1; then
  hrn_err "E008" "필수 실행체 rsync를 찾을 수 없습니다 (B1: cp 폴백 제거 — rsync 필수)" \
    "rsync를 설치하세요 (Debian/Ubuntu: sudo apt install rsync, macOS: brew install rsync)" \
    "rsync가 있는 다른 환경에서 install/setup을 실행하세요"
  exit 1
fi

HAVE_PYTHON3=1
if ! command -v python3 >/dev/null 2>&1; then
  HAVE_PYTHON3=0
  warn "python3 미발견 — vault_root/훅 자동 반영이 일부 제한됩니다 (수동 안내로 대체, 비차단)."
fi

ok "사전 점검 통과"
echo

# ---- 2. 대상 경로 -----------------------------------------------------------

TARGET_ARG="${1:-}"
if [ -n "$TARGET_ARG" ]; then
  TARGET_RAW="$TARGET_ARG"
else
  TARGET_RAW="$(ask "설치할 대상 프로젝트 경로는?" "$(pwd)")"
fi

if ! mkdir -p "$TARGET_RAW" 2>/dev/null; then
  hrn_err "E007" "대상 경로를 생성할 수 없습니다: ${TARGET_RAW}" \
    "쓰기 권한이 있는 다른 경로를 지정하세요" \
    "상위 디렉토리 권한을 조정한 뒤 재실행하세요"
  exit 1
fi
TARGET_DIR="$(cd "$TARGET_RAW" && pwd)"

if [ ! -w "$TARGET_DIR" ]; then
  hrn_err "E007" "대상 경로에 쓰기 권한이 없습니다: ${TARGET_DIR}" \
    "쓰기 권한이 있는 다른 경로를 지정하세요" \
    "디렉토리 권한을 조정(chmod 등)한 뒤 재실행하세요"
  exit 1
fi

# 자기 자신(또는 소스 트리 내부)에 설치 금지 — harness_copy는 rsync --delete로
# 대상을 소스에 맞춰 정리하므로, 대상이 소스 안이면 소스 트리를 스스로 훼손한다.
# 비TTY에서 인자 없이 실행하면 대상 디폴트가 현재 경로(=소스 레포)라 특히 걸리기 쉽다.
if [ "$TARGET_DIR" = "$SOURCE_DIR" ] || case "$TARGET_DIR" in "${SOURCE_DIR}/"*) true ;; *) false ;; esac; then
  hrn_err "E007" "대상이 하네스 소스 레포 자신(또는 그 하위)입니다: ${TARGET_DIR}" \
    "설치할 프로젝트 경로를 인자로 지정하세요: ${SCRIPT_DIR}/setup /path/to/project" \
    "자기 자신에 설치(도그푸딩)는 아직 지원하지 않습니다 — 소스 레포 밖의 경로를 쓰세요"
  exit 1
fi

say "대상 경로: ${TARGET_DIR}"
CONFIRM="$(ask_yn "이 경로에 설치를 진행할까요?" "Y")"
if [ "$CONFIRM" != "Y" ]; then
  say "설치를 취소했습니다."
  exit 0
fi
echo

# ---- 2b. 사전 점검 L1: 하네스 실행체 실존 확인 (B7, 설계 §3-4) ---------------
# 대상에 이미 컨피그가 있으면 그 값을, 신규 설치라 아직 없으면(복사 전) 소스의
# 템플릿 컨피그 값을 active_harness로 본다. 미발견이어도 설치 자체는 막지 않는다
# (비차단 경고 W013 — 흐름 시작 시점의 차단(E008/E010)은 플레이북 §1 소관).
CONFIG_FOR_L1="${TARGET_DIR}/harness.config.yaml"
[ -f "$CONFIG_FOR_L1" ] || CONFIG_FOR_L1="${SOURCE_DIR}/config/harness.config.template.yaml"
ACTIVE_HARNESS_L1="$(read_active_harness "$CONFIG_FOR_L1")"
HARNESS_BIN_L1="$(harness_executable_for "$ACTIVE_HARNESS_L1")"
if [ -n "$HARNESS_BIN_L1" ]; then
  if command -v "$HARNESS_BIN_L1" >/dev/null 2>&1; then
    ok "하네스 실행체 확인: ${HARNESS_BIN_L1} (active_harness: ${ACTIVE_HARNESS_L1})"
  else
    hrn_warn "W013" "하네스 실행체 미발견: ${HARNESS_BIN_L1} (active_harness: ${ACTIVE_HARNESS_L1})" \
      "${HARNESS_BIN_L1} CLI를 설치한 뒤 사용하세요 (공식 설치 가이드 참고)"
  fi
else
  note "active_harness='${ACTIVE_HARNESS_L1:-미상}' — 실행체 확인 방법이 정의되지 않아 건너뜁니다 (해당 어댑터 소유)"
fi
echo

# ---- 2c. 사전 점검 L1b: superpowers 플러그인 전제 확인 (설계 §3-2, HRN-W014) --
# L1과 같은 컨피그(CONFIG_FOR_L1)를 본다. active_harness가 claude일 때만 적용한다
# (플러그인 매니페스트는 Claude Code 고유 규격 → 다른 값이면 해당 어댑터 소관이라
# note로 건너뜀). 컨피그에 superpowers: 스킬이 0개면 점검 자체를 건너뛴다(컨피그에서
# 다 빼버린 사용자를 괴롭히지 않음). 비차단 — W014를 내도 설치는 끝까지 진행한다.
SUPERPOWERS_STATUS="점검 안 함"
if [ "$ACTIVE_HARNESS_L1" = "claude" ]; then
  SP_STAGE_SKILLS="$(superpowers_skills_in_config "$CONFIG_FOR_L1")"
  if [ -z "$SP_STAGE_SKILLS" ]; then
    note "컨피그에 superpowers: 스킬이 없어 전제 점검을 건너뜁니다"
  else
    SP_DETECT="$(detect_superpowers)"
    SP_RESULT="$(printf '%s\n' "$SP_DETECT" | sed -n '1p')"
    SP_MANIFEST="$(printf '%s\n' "$SP_DETECT" | sed -n '2p')"
    SP_STAGE_COUNT="$(printf '%s\n' "$SP_STAGE_SKILLS" | grep -c . || true)"
    case "$SP_RESULT" in
      found:*)
        SP_VERSION="${SP_RESULT#found:}"
        SUPERPOWERS_STATUS="확인됨 v${SP_VERSION}"
        ok "superpowers 확인: v${SP_VERSION} (${SP_STAGE_COUNT}개 구간에서 사용)"
        ;;
      unknown)
        SUPERPOWERS_STATUS="확인 불가, 건너뜀"
        note "superpowers 설치 여부를 확인할 수 없어 건너뜁니다 (python3/grep 모두 미발견 — fail-open)"
        ;;
      notfound|nomanifest)
        SUPERPOWERS_STATUS="미발견(W014)"
        SP_STAGES_FMT="$(printf '%s\n' "$SP_STAGE_SKILLS" | cut -d: -f1 | sort -u | join_lines '·')"
        SP_SKILLS_FMT="$(printf '%s\n' "$SP_STAGE_SKILLS" | cut -d: -f2- | sort -u | join_lines ', ')"
        hrn_warn "W014" "superpowers 플러그인 미발견 (확인 경로: ${SP_MANIFEST}) — 영향 구간: ${SP_STAGES_FMT} (스킬: ${SP_SKILLS_FMT})" \
          "/plugin marketplace add obra/superpowers-marketplace 후 /plugin install superpowers 로 플러그인 설치" \
          "harness.config.yaml의 해당 stages[].skills에서 superpowers: 항목 제거"
        ;;
    esac
  fi
else
  note "active_harness='${ACTIVE_HARNESS_L1:-미상}' — superpowers 전제 점검은 Claude Code 전용이라 건너뜁니다"
fi
echo

# ---- 3. 배포물 복사 ----------------------------------------------------------

HARNESS_DIR="${TARGET_DIR}/.harness"
say "배포물 복사 중 → ${HARNESS_DIR}"
CHANGED_FILES="$(harness_copy "$SOURCE_DIR" "$HARNESS_DIR")"
ok "복사 완료 (${CHANGED_FILES}개 항목 갱신)"
echo

# ---- 4. 컨피그 --------------------------------------------------------------

TARGET_CONFIG="${TARGET_DIR}/harness.config.yaml"
TEMPLATE_CONFIG="${HARNESS_DIR}/config/harness.config.template.yaml"
CONFIG_CREATED=0
CONFIG_STATUS=""

if [ -f "$TARGET_CONFIG" ]; then
  CONFIG_STATUS="기존 유지 (덮어쓰지 않음)"
  say "harness.config.yaml 이미 존재 — 기존 설정을 그대로 유지합니다: ${TARGET_CONFIG}"
else
  if [ ! -f "$TEMPLATE_CONFIG" ]; then
    hrn_err "E005" "배포물에 템플릿 컨피그가 없습니다 (${TEMPLATE_CONFIG})" \
      "소스 레포에 config/harness.config.template.yaml이 있는지 확인 후 재실행" \
      "install/update 또는 재설치로 소스를 갱신 후 재시도"
    exit 1
  fi
  cp "$TEMPLATE_CONFIG" "$TARGET_CONFIG"
  CONFIG_CREATED=1
  CONFIG_STATUS="신규 생성"
  ok "harness.config.yaml 생성: ${TARGET_CONFIG}"
fi
echo

# ---- 5. 대화형 세팅 (vault_root) --------------------------------------------

VAULT_ROOT=""
if [ "$CONFIG_CREATED" -eq 1 ]; then
  # vault 탐지 → 번호 선택. 탐지 실패 시 기존 자유 입력으로 열화한다(설계 §3-5).
  VAULT_LINES="$(detect_obsidian_vaults)"

  if [ -n "$VAULT_LINES" ]; then
    VAULT_PATHS=()
    VAULT_OPTS=()
    while IFS="$(printf '\t')" read -r _vname _vpath; do
      [ -n "$_vpath" ] || continue
      VAULT_PATHS+=("$_vpath")
      VAULT_OPTS+=("$(printf '%-14s %s' "$_vname" "$_vpath")")
    done <<< "$VAULT_LINES"

    say "Obsidian 등록 vault ${#VAULT_PATHS[@]}개를 찾았습니다."
    VAULT_OPTS+=("직접 경로 입력")
    VAULT_OPTS+=("건너뛰기 (나중에 harness.config.yaml 에서 지정)")

    VAULT_N=${#VAULT_OPTS[@]}
    VAULT_PICK="$(ask_choice "storage.vault_root 를 지정하시겠습니까?" "$VAULT_N" "${VAULT_OPTS[@]}")"

    if [ "$VAULT_PICK" -le "${#VAULT_PATHS[@]}" ]; then
      VAULT_ROOT="${VAULT_PATHS[$((VAULT_PICK - 1))]}"
    elif [ "$VAULT_PICK" -eq "$((VAULT_N - 1))" ]; then
      VAULT_ROOT="$(ask "vault 절대경로를 입력하세요 — 건너뛰려면 Enter" "")"
    else
      VAULT_ROOT=""
    fi
  else
    VAULT_ROOT="$(ask "storage.vault_root (Obsidian vault 절대경로) — 건너뛰려면 Enter" "")"
  fi
  if [ -n "$VAULT_ROOT" ]; then
    if [ "$HAVE_PYTHON3" -eq 1 ]; then
      if python3 - "$TARGET_CONFIG" "$VAULT_ROOT" <<'PYEOF'
import re
import sys

path, value = sys.argv[1], sys.argv[2]
with open(path, encoding="utf-8") as f:
    text = f.read()

# 값이 null이든 이미 박힌 문자열이든 통째로 교체한다(주석은 보존).
# null에만 매치하던 이전 버전은 템플릿이 오염되면 사용자의 선택을 조용히 버렸다.
new_text, n = re.subn(
    r'^(\s*vault_root:\s*)(?:"[^"]*"|\'[^\']*\'|[^\s#]+)(\s*#.*)?$',
    lambda m: f'{m.group(1)}"{value}"' + (m.group(2) or ""),
    text,
    count=1,
    flags=re.M,
)
if n == 0:
    sys.exit(1)

with open(path, "w", encoding="utf-8") as f:
    f.write(new_text)
PYEOF
      then
        ok "vault_root 설정 완료: ${VAULT_ROOT}"
      else
        warn "vault_root 자동 반영 실패 — harness.config.yaml의 storage.vault_root를 직접 수정하세요: \"${VAULT_ROOT}\""
      fi
    else
      warn "python3 미발견 — harness.config.yaml의 storage.vault_root를 직접 \"${VAULT_ROOT}\" 로 수정하세요."
    fi
  else
    hrn_warn "W010" "vault_root 미지정 — 저장 건너뜀 (문서는 작업 공간에 보관)" \
      "harness.config.yaml의 storage.vault_root를 지정하면 다음부터 저장됩니다"
  fi
else
  say "기존 컨피그를 사용합니다 — vault_root 등 설정 변경은 harness.config.yaml을 직접 수정하세요."
fi
echo

# ---- 6. 훅 연결 --------------------------------------------------------------

CLAUDE_SETTINGS_DIR="${TARGET_DIR}/.claude"
CLAUDE_SETTINGS="${CLAUDE_SETTINGS_DIR}/settings.json"
# shellcheck disable=SC2016
# 의도적 단일 따옴표: $CLAUDE_PROJECT_DIR는 이 스크립트가 지금 확장할 값이 아니라,
# settings.json에 문자 그대로 기록되어 나중에 Claude Code 세션이 훅을 실행할 때
# 그 세션의 환경변수로 확장되어야 하는 리터럴 문자열이다.
HOOK_CMD='"$CLAUDE_PROJECT_DIR"/.harness/adapters/claude/hooks/session-start.sh'
HOOK_STATUS="수동 연결 필요"

if [ "$HAVE_PYTHON3" -eq 1 ]; then
  mkdir -p "$CLAUDE_SETTINGS_DIR"
  if python3 - "$CLAUDE_SETTINGS" "$HOOK_CMD" <<'PYEOF'
import json
import os
import sys

path, cmd = sys.argv[1], sys.argv[2]
data = {}
if os.path.exists(path):
    with open(path, encoding="utf-8") as f:
        raw = f.read().strip()
    data = json.loads(raw) if raw else {}

hooks = data.setdefault("hooks", {})
session_start = hooks.setdefault("SessionStart", [])

already = any(
    h.get("command") == cmd
    for group in session_start
    for h in group.get("hooks", [])
)
if not already:
    session_start.append({"hooks": [{"type": "command", "command": cmd}]})

with open(path, "w", encoding="utf-8") as f:
    json.dump(data, f, ensure_ascii=False, indent=2)
    f.write("\n")
PYEOF
  then
    HOOK_STATUS="연결됨 (기존 훅 보존)"
    ok "SessionStart 훅 연결 완료: ${CLAUDE_SETTINGS}"
  else
    HOOK_STATUS="병합 실패 — 수동 연결 필요"
    warn "settings.json 병합 실패 — 아래 내용을 수동으로 추가하세요."
    warn "  파일: ${CLAUDE_SETTINGS}"
    warn "  hooks.SessionStart 배열에: { \"hooks\": [ { \"type\": \"command\", \"command\": \"${HOOK_CMD}\" } ] }"
  fi
else
  warn "python3 미발견 — 훅 자동 연결 불가. 아래 내용을 수동으로 추가하세요."
  warn "  파일: ${CLAUDE_SETTINGS}"
  warn "  hooks.SessionStart 배열에: { \"hooks\": [ { \"type\": \"command\", \"command\": \"${HOOK_CMD}\" } ] }"
fi
echo

# ---- 7. .harness/.meta 기록 --------------------------------------------------

SOURCE_COMMIT="unknown"
if command -v git >/dev/null 2>&1 && git -C "$SOURCE_DIR" rev-parse HEAD >/dev/null 2>&1; then
  SOURCE_COMMIT="$(git -C "$SOURCE_DIR" rev-parse HEAD)"
fi
INSTALLED_AT="$(date -Iseconds 2>/dev/null || date)"

META_FILE="${HARNESS_DIR}/.meta"
{
  printf 'SOURCE_PATH=%s\n' "$SOURCE_DIR"
  printf 'SOURCE_COMMIT=%s\n' "$SOURCE_COMMIT"
  printf 'INSTALLED_AT=%s\n' "$INSTALLED_AT"
} > "$META_FILE"
ok ".meta 기록: ${META_FILE}"
echo

# ---- 7c. 대상 .gitignore 처리 ------------------------------------------------
# 설치본(.harness/ 밑 배포물)이 대상 저장소 diff 를 오염시키지 않게 한 번 묻는다.
# 이 절은 **설치 스크립트가 대상 저장소의 파일을 고치는 유일한 자리**다 —
# 그래서 (a) git 저장소가 아니면 손대지 않고 (b) 이미 있는 항목은 다시 넣지 않으며
# (c) 사용자가 거절하면 아무것도 바꾸지 않고 (d) 무엇을 했는지 요약에 남긴다.
# /.harness/work/ 는 **제외하지 않는다** — 작업 산출물은 프로젝트 자산이다
# (이 레포가 자기 .gitignore 에 남긴 판단과 같다).

GITIGNORE_STATUS="건너뜀 (git 저장소 아님)"
TARGET_GITIGNORE="${TARGET_DIR}/.gitignore"

if command -v git >/dev/null 2>&1 && git -C "$TARGET_DIR" rev-parse --git-dir >/dev/null 2>&1; then
  say "설치본(.harness/ 밑 배포물)을 이 저장소 git 에 커밋할까요?"
  GI_PICK="$(ask_choice "선택" 1 \
    "커밋 안 함 — .gitignore 에 설치본 경로를 추가한다 (추천)" \
    "커밋함 — .gitignore 를 바꾸지 않는다")"

  if [ "$GI_PICK" = "1" ]; then
    GI_CREATED="no"
    if [ ! -f "$TARGET_GITIGNORE" ]; then
      : > "$TARGET_GITIGNORE"
      GI_CREATED="yes"
    fi
    GI_ADDED=0
    for pat in /.harness/install/ /.harness/adapters/ /.harness/core/ \
               /.harness/skills/ /.harness/templates/ /.harness/config/ /.harness/.meta; do
      if ! grep -qxF "$pat" "$TARGET_GITIGNORE"; then
        if [ "$GI_ADDED" -eq 0 ]; then
          {
            printf '\n'
            printf '# 하네스 설치 산출물 — 소스에서 재생성되므로 커밋하지 않는다.\n'
            printf '# (.harness/work/ 는 의도적으로 제외하지 않는다 — 작업 문서는 프로젝트 자산)\n'
          } >> "$TARGET_GITIGNORE"
        fi
        printf '%s\n' "$pat" >> "$TARGET_GITIGNORE"
        GI_ADDED=$((GI_ADDED + 1))
      fi
    done
    if [ "$GI_CREATED" = "yes" ]; then
      ok ".gitignore 를 새로 만들고 설치본 경로 ${GI_ADDED}개를 추가했습니다: ${TARGET_GITIGNORE}"
      GITIGNORE_STATUS="신규 생성 + ${GI_ADDED}개 추가"
    elif [ "$GI_ADDED" -gt 0 ]; then
      ok ".gitignore 에 설치본 경로 ${GI_ADDED}개를 추가했습니다: ${TARGET_GITIGNORE}"
      GITIGNORE_STATUS="${GI_ADDED}개 추가"
    else
      ok ".gitignore 에 설치본 경로가 이미 전부 있습니다 (변경 없음)"
      GITIGNORE_STATUS="이미 적용됨 (변경 없음)"
    fi
  else
    note ".gitignore 를 바꾸지 않았습니다 — 설치본이 이 저장소 커밋에 포함됩니다."
    GITIGNORE_STATUS="사용자 선택으로 미적용"
  fi
  echo
fi

# ---- 7b. 컨피그 검증 ---------------------------------------------------------

CONFIG_VALID="미실행"
if [ ! -f "${SCRIPT_DIR}/validate-config" ]; then
  CONFIG_VALID="건너뜀 (검증기 없음 — install/update로 최신본을 받으세요)"
elif [ ! -x "${SCRIPT_DIR}/validate-config" ]; then
  hrn_warn "W020" "컨피그 검증기를 실행할 수 없습니다 (파일은 존재, 사유: 실행 권한 없음)" \
    "chmod +x ${SCRIPT_DIR}/validate-config 후 재실행하세요" \
    "검증 없이 진행 — 컨피그 오타는 해당 구간에 도달할 때 드러납니다"
  CONFIG_VALID="건너뜀 (검증기 실행 불가 — 위 HRN-W020 참조)"
else
  set +e
  "${SCRIPT_DIR}/validate-config" "${TARGET_CONFIG}"
  VC_RC=$?
  set -e
  case "$VC_RC" in
    0) CONFIG_VALID="통과" ;;
    2) CONFIG_VALID="건너뜀 (검증 전제 미충족 — 위 HRN-W015 참조)" ;;
    *) CONFIG_VALID="실패 (위 오류 참조 — 설치는 완료됨)" ;;
  esac
fi
echo

# ---- 8. 종료 요약 ------------------------------------------------------------

say "=== 설치 요약 ==="
say "대상 경로   : ${TARGET_DIR}"
say "소스 커밋   : ${SOURCE_COMMIT}"
say "컨피그      : ${CONFIG_STATUS} (${TARGET_CONFIG})"
say "SessionStart 훅: ${HOOK_STATUS}"
say "superpowers : ${SUPERPOWERS_STATUS}"
say "컨피그 검증: ${CONFIG_VALID}"
say ".gitignore  : ${GITIGNORE_STATUS}"
echo
say "다음 할 일:"
if [ "$CONFIG_CREATED" -eq 1 ] && [ -z "$VAULT_ROOT" ]; then
  say "  - harness.config.yaml의 storage.vault_root 지정 (미지정 시 HRN-W010이 매 실행 안내됩니다)"
fi
say "  - ${TARGET_DIR}에서 Claude Code 세션을 시작하면 SessionStart 훅으로 플레이북이 로드됩니다"
say "  - PRD.md·CLAUDE.md·AGENTS.md가 없으면 그 세션에서 초기 세팅을 제안합니다 (set-initial)"
say "  - 다음 업데이트: ${HARNESS_DIR}/install/update"
ok "설치 완료"
